{
	servers {
		trusted_proxies static private_ranges
	}

	order rate_limit before file_server
}

:3000 {
	root * /usr/share/caddy/html

	# Per-client-IP rate limiting for static asset requests. The build is split into over a thousand small chunks and
	# a cold load asks for several hundred of them at once, so 300 a minute answered the app's own scripts with 429.
	rate_limit {
		zone static {
			key {client_ip}
			events 3000
			window 1m
		}
	}

	# Build output is named by its hash and never changes under that name: cache it for a year, so a repeat visit
	# and every navigation after the first ask for nothing
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Security headers (HSTS is set at the TLS terminator)
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
	}

	# SPA fallback
	try_files {path} /index.html
	file_server

	# Access logs to stdout (default in Caddy)
	log {
		output stdout
		format console
	}
}
